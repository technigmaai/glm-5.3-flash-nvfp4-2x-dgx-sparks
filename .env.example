# Copy to .env and adapt the paths, interfaces, and addresses for both nodes.

# Published qualified ARM64 image
IMAGE=technigmaai/glm-5.3-flash-nvfp4-2x-dgx-sparks:r27.0-a-pr57443-arm64-sm121

# Model (pin the same revision on both nodes)
MODEL_PATH=local-inference-lab/GLM-5.3-Flash-NVFP4
MODEL_REVISION=175ae8ce3b5af842b0d0140dbeb43e9cfc557c49
SERVED_MODEL_NAME="gx10 local-inference-lab/GLM-5.3-Flash-NVFP4"
HF_CACHE=/home/your-user/.cache/huggingface

# Two-node RoCE network
NCCL_IB_HCA=rocep1s0f0,roceP2p1f0
NCCL_SOCKET_IFNAME=enp1s0f0np0,enP2p1f0np0
CONTROL_IF=enp1s0f0np0
HEAD_ROCE_IP=192.168.200.10
WORKER_ROCE_IP=192.168.200.11
MASTER_ADDR=192.168.200.10
WORKER_SSH_TARGET=your-user@192.168.1.7
WORKER_DIR=/home/your-user/Development/ai-tools/glm-5.3-flash-nvfp4-2x-dgx-sparks

# Distributed serving
PORT=8000
MASTER_PORT=29553
TP_SIZE=2
OMP_NUM_THREADS=4

# Qualified production profile
GPU_MEMORY_UTILIZATION=0.89
KV_CACHE_MEMORY_BYTES=11700M
KV_CACHE_DTYPE=fp8
MAX_MODEL_LEN=1047552
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
GLM53_SPLIT_TARGET_BLOCK_SIZE=1024

# MTP3
SPECULATOR=mtp
MTP_TOKENS=3
MTP_MOE_BACKEND=marlin
GLM53_MTP_DRAFT_HEAD=nvfp4
MTP_LOCAL_ARGMAX=true
CUSTOM_ALL_REDUCE=1
VLLM_ENABLE_ROCE_ALLREDUCE=1
VLLM_ROCE_ALLREDUCE_MAX_SIZE=2MB
KDA_PREFILL_BACKEND=b12x
TARGET_MOE_BACKEND=b12x
ASYNC_SCHEDULING=1
PREFIX_CACHING=1

# Optional scheduling experiments. Leave FAIRNESS_ENGINE empty for the
# qualified baseline. Supported values are compute_share and micro_slicing.
FAIRNESS_ENGINE=
PREFILL_COMPUTE_SHARE=
MAX_NUM_PREFILL_TOKENS_PER_STEP=
MAX_NUM_PARTIAL_PREFILLS=0
DECODE_PREFILL_MIN_DECODE_STEPS=0
DECODE_PREFILL_MAX_WAIT_MS=0

# Mounted chat template
CHAT_TEMPLATE=/opt/glm53/chat_template.jinja

# Optional DFlash2 rollback/experiment values; unused while SPECULATOR=mtp
DFLASH_TOKENS=7
DFLASH_MODEL=local-inference-lab/GLM-5.3-Flash-DFlash2
DFLASH_REVISION=dfa270d7eb8df37e0cd0d4420f8dd0bd24ffcd50
DFLASH_KV_CACHE_MEMORY_BYTES=12800M
