# Copy this file to .env and adapt paths, interfaces, and addresses on the head.
# start.sh synchronizes the public recipe and local .env to the worker.

# Published Linux/ARM64 image for GB10 / SM121a. R28.3-A preserves R28.2
# and adds the pinned vLLM PR #58454 GLM k-pool tail-ring correctness fix.
IMAGE=technigmaai/glm-5.3-flash-nvfp4-2x-dgx-sparks:r28.3-a-pr58454-arm64-sm121-cu134

# R28.1 reclaims the firmware-reserved 1.75 GiB display scanout on each
# headless Spark as KV backing. See docs/display-kv-r28.1.md before enabling.
DISPLAY_KV_ENABLE=1
DISPLAY_KV_MIN_BYTES=4294967296
DRM_CARD_GID=44

# Pin the same model revision on both nodes.
MODEL_PATH=local-inference-lab/GLM-5.3-Flash-NVFP4
MODEL_REVISION=175ae8ce3b5af842b0d0140dbeb43e9cfc557c49
SERVED_MODEL_NAME="gx10 local-inference-lab/GLM-5.3-Flash-NVFP4"
HF_CACHE=/home/your-user/.cache/huggingface

# Two-node RoCE network. Replace these with the interfaces and addresses from
# your systems. CONTROL_IF is used for SSH readiness; model traffic uses RoCE.
NCCL_IB_HCA=rocep1s0f0,roceP2p1f0
NCCL_SOCKET_IFNAME=enp1s0f0np0,enP2p1f0np0
CONTROL_IF=enp1s0f0np0
HEAD_ROCE_IP=192.168.200.10
WORKER_ROCE_IP=192.168.200.11
MASTER_ADDR=192.168.200.10
WORKER_SSH_TARGET=your-user@192.168.1.7
WORKER_ROCE_SSH_TARGET=your-user@192.168.200.11
WORKER_DIR=/home/your-user/Development/ai-tools/glm-5.3-flash-nvfp4-2x-dgx-sparks

# Distributed serving
PORT=8000
MASTER_PORT=29553
TP_SIZE=2
DCP_SIZE=1
CP_KV_CACHE_INTERLEAVE_SIZE=1
OMP_NUM_THREADS=1

# Qualified one-million-token production profile. Fixed KV sizing overrides
# automatic sizing from GPU_MEMORY_UTILIZATION.
GPU_MEMORY_UTILIZATION=0.87
KV_CACHE_MEMORY_BYTES=11840M
KV_CACHE_DTYPE=fp8
MAX_MODEL_LEN=1047552
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
GLM53_SPLIT_TARGET_BLOCK_SIZE=1024

# MTP3 decode path
SPECULATOR=mtp
MTP_TOKENS=3
MTP_MOE_BACKEND=marlin
MTP_ATTENTION_BACKEND=B12X
MTP_DRAFT_SAMPLE_METHOD=greedy
MTP_REJECTION_SAMPLE_METHOD=standard
MTP_ADAPTIVE_WINDOW=
MTP_ADAPTIVE_INITIAL=
GLM53_MTP_DRAFT_HEAD=nvfp4
MTP_LOCAL_ARGMAX=true
MTP_DISABLE_EAGLE_BLOCK_DROP=true

# Target model and TP communication
TARGET_MOE_BACKEND=b12x
KDA_PREFILL_BACKEND=b12x
B12X_AUTOTUNE_EXHAUSTIVE=0
CUSTOM_ALL_REDUCE=1
VLLM_ENABLE_ROCE_ALLREDUCE=1
VLLM_ROCE_ALLREDUCE_MAX_SIZE=2MB
VLLM_PCIE_ALLREDUCE_BACKEND=b12x

# Scheduler and cache
ASYNC_SCHEDULING=1
PREFIX_CACHING=1
PREFIX_MATCH_UNIT=128
ENABLE_PROMPT_TOKENS_DETAILS=1

# Image-capable profile: up to 32 images per request, no video. The processor
# cache value applies per cache instance and bounds growth under image traffic.
MAX_IMAGES_PER_PROMPT=32
MAX_VIDEOS_PER_PROMPT=0
MM_PROCESSOR_CACHE_GB=1
SKIP_MM_PROFILING=0

# Mounted chat template. Leave empty to use the model's bundled template.
CHAT_TEMPLATE=/opt/glm53/chat_template.jinja

# InstantTensor's removed legacy loader options must stay disabled on R28.
INSTANTTENSOR_EXTRA_CONFIG=0

# Fairness experiments are intentionally disabled in the qualified baseline.
# micro_slicing uses the four MAX/DECODE values; compute_share uses
# PREFILL_COMPUTE_SHARE. Set only after establishing a matched baseline.
FAIRNESS_ENGINE=
PREFILL_COMPUTE_SHARE=
MAX_NUM_PREFILL_TOKENS_PER_STEP=2048
MAX_NUM_PARTIAL_PREFILLS=4
DECODE_PREFILL_MIN_DECODE_STEPS=1
DECODE_PREFILL_MAX_WAIT_MS=0

# Optional DFlash2 experiment; unused while SPECULATOR=mtp.
DFLASH_TOKENS=7
DFLASH_MODEL=local-inference-lab/GLM-5.3-Flash-DFlash2
DFLASH_REVISION=dfa270d7eb8df37e0cd0d4420f8dd0bd24ffcd50
DFLASH_KV_CACHE_MEMORY_BYTES=12800M
