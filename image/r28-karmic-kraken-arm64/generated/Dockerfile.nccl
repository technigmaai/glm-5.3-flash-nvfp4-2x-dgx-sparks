# syntax=docker/dockerfile:1.7

ARG BUILDER_IMAGE
FROM ${BUILDER_IMAGE} AS build

ARG BUILD_JOBS=48
ARG NCCL_PACKAGE_VERSION
ARG NCCL_SOURCE_COMMIT
ARG NCCL_SOURCE_DATE_EPOCH
ENV CUDA_HOME=/usr/local/cuda \
    NVCC_GENCODE="-gencode=arch=compute_121,code=sm_121 -gencode=arch=compute_121,code=compute_121"

COPY . /src/nccl
WORKDIR /src/nccl
RUN test "$(git rev-parse HEAD 2>/dev/null || true)" = "" \
 || test "$(git rev-parse HEAD)" = "${NCCL_SOURCE_COMMIT}"
RUN --mount=type=cache,id=lil-nccl-cu134-sm121-build,target=/src/nccl/build,sharing=locked \
    make -j"${BUILD_JOBS}" src.build \
      CUDA_HOME="${CUDA_HOME}" NVCC_GENCODE="${NVCC_GENCODE}" \
 && test -f "/src/nccl/build/lib/libnccl.so.2.31.2" \
 && strings /src/nccl/build/lib/libnccl.so.2.31.2 \
      | grep -F 'NCCL version 2.31.2 compiled with CUDA 13.4'

RUN --mount=type=cache,id=lil-nccl-cu134-sm121-build,target=/src/nccl/build,sharing=locked \
    mkdir -p \
      ci/lil_wheels/package/local_inference_nccl/lib \
      ci/lil_wheels/package/local_inference_nccl/include \
      /artifacts/wheels /artifacts/native/nccl/lib /artifacts/native/nccl/include \
 && install -m 0755 build/lib/libnccl.so.2.31.2 \
      ci/lil_wheels/package/local_inference_nccl/lib/libnccl.so.2.31.2 \
 && patchelf --set-rpath '$ORIGIN/../../nvidia/cu13/lib' \
      ci/lil_wheels/package/local_inference_nccl/lib/libnccl.so.2.31.2 \
 && cp -a build/include/. \
      ci/lil_wheels/package/local_inference_nccl/include/ \
 && printf 'NCCL_VERSION = "2.31.2"\nSOURCE_COMMIT = "%s"\n' \
      "${NCCL_SOURCE_COMMIT}" \
      > ci/lil_wheels/package/local_inference_nccl/_build_meta.py \
 && LOCAL_INFERENCE_NCCL_PACKAGE_VERSION="${NCCL_PACKAGE_VERSION}" \
      SOURCE_DATE_EPOCH="${NCCL_SOURCE_DATE_EPOCH}" \
      python -m pip wheel --no-build-isolation --no-deps \
        --wheel-dir /artifacts/wheels ci/lil_wheels/package \
 && test "$(find /artifacts/wheels -maxdepth 1 -name 'local_inference_nccl_cu134-*.whl' | wc -l)" -eq 1 \
 && install -m 0755 build/lib/libnccl.so.2.31.2 \
      /artifacts/native/nccl/lib/libnccl.so.2.31.2 \
 && ln -s libnccl.so.2.31.2 /artifacts/native/nccl/lib/libnccl.so.2 \
 && ln -s libnccl.so.2 /artifacts/native/nccl/lib/libnccl.so \
 && cp -a build/include/. /artifacts/native/nccl/include/

FROM ${BUILDER_IMAGE} AS validate
ARG NCCL_PACKAGE_VERSION
ARG NCCL_SOURCE_COMMIT
COPY --from=build /artifacts /artifacts
RUN python -m venv /tmp/nccl-wheel-test \
 && /tmp/nccl-wheel-test/bin/pip install --no-deps /artifacts/wheels/*.whl \
 && EXPECTED_VERSION="${NCCL_PACKAGE_VERSION}" \
    EXPECTED_COMMIT="${NCCL_SOURCE_COMMIT}" \
    /tmp/nccl-wheel-test/bin/python -I - <<'PY'
import ctypes
import importlib.metadata
import os

import local_inference_nccl

assert importlib.metadata.version("local-inference-nccl-cu134") == os.environ["EXPECTED_VERSION"]
assert local_inference_nccl.SOURCE_COMMIT == os.environ["EXPECTED_COMMIT"]
assert (local_inference_nccl.include_path() / "nccl_device" / "core.h").is_file()
library = ctypes.CDLL(str(local_inference_nccl.library_path()))
version = ctypes.c_int()
assert library.ncclGetVersion(ctypes.byref(version)) == 0
assert version.value == 23102
print(local_inference_nccl.library_path())
PY

FROM scratch AS artifacts
COPY --from=validate /artifacts /
